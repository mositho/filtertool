{
  "name": "filter",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run format:check",
    "postinstall": "npm run generate-types && npm run generate-sound-types",
    "export": "ts-node ./src/scripts/export.ts",
    "export-all": "ts-node ./src/scripts/export-all.ts",
    "filtertool": "ts-node ./src/scripts/filtertool.ts",
    "server": "ts-node ./src/server/index.ts",
    "frontend:dev": "vite --config frontend/vite.config.ts",
    "frontend:build": "vite build --config frontend/vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preexport": "npm run prepare-sounds",
    "preexport-all": "npm run prepare-sounds",
    "update-basetypes": "ts-node ./src/scripts/update-base-types.ts",
    "generate": "npm run generate-types && npm run generate-sound-types",
    "generate-types": "ts-node ./src/scripts/generate-types.ts",
    "generate-sound-types": "ts-node ./src/scripts/generate-sound-types.ts",
    "generate-sounds": "ts-node ./src/scripts/generate-sounds.ts",
    "sync-sounds": "ts-node ./src/scripts/sync-sounds.ts",
    "clean-tts": "ts-node ./src/scripts/clean-sounds.ts",
    "prepare-sounds": "npm run generate-types && npm run clean-tts && npm run generate-sound-types && npm run sync-sounds",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "fast-csv": "^5.0.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "glob": "^13.0.6",
    "google-tts-api": "^2.0.2",
    "primevue": "^4.5.5",
    "vue": "^3.5.41"
  }
}
